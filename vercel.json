{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "crons": [
    {
      "path": "/api/cron/purge-original",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/process-screenings",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/interview-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/ops-alerts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/expire-interviews",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/reconcile-payments",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 0 * * *"
    }
  ]
}
